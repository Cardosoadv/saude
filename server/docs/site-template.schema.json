{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordojuris/schemas/site-template.schema.json",
  "title": "template.json do site OrdoJuris",
  "description": "Descrição para editores/IDEs. A validação oficial é App\\Libraries\\Site\\Template\\ManifestValidator.",
  "type": "object",
  "required": ["slug", "nome", "versao", "motor", "layouts", "secoes", "paginas_obrigatorias"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 60 },
    "nome": { "type": "string", "minLength": 1, "maxLength": 100 },
    "versao": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "autor": { "type": "string", "maxLength": 100 },
    "descricao": { "type": "string", "maxLength": 255 },
    "ordojuris": { "type": "string", "pattern": "^>=\\s*\\d+\\.\\d+\\.\\d+$" },
    "motor": { "enum": ["php", "twig"] },
    "layouts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/chave" } },
    "menus": { "type": "array", "items": { "$ref": "#/$defs/chave" } },
    "tema": {
      "type": "object",
      "properties": {
        "cores": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" } },
        "fontes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[\\p{L}0-9 ]{1,60}$" } }
      }
    },
    "textos": { "type": "object", "additionalProperties": { "type": "string" } },
    "paginas_obrigatorias": { "type": "array", "contains": { "const": "home" } },
    "secoes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/chave" },
      "additionalProperties": {
        "type": "object",
        "required": ["rotulo", "campos"],
        "properties": {
          "rotulo": { "type": "string", "minLength": 1 },
          "campos": { "$ref": "#/$defs/campos" }
        }
      }
    }
  },
  "$defs": {
    "chave": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "campos": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/chave" },
      "additionalProperties": { "$ref": "#/$defs/campo" }
    },
    "campo": {
      "type": "object",
      "required": ["tipo"],
      "properties": {
        "tipo": { "enum": ["texto", "texto_inline", "textarea", "rich_text", "imagem", "icone", "link", "opcao", "bool", "lista", "referencia_menu", "dinamico"] },
        "obrigatorio": { "type": "boolean" },
        "max": { "type": "integer", "minimum": 1 },
        "padrao": {},
        "opcoes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "itens": { "$ref": "#/$defs/campos" },
        "fonte": { "enum": ["ultimas_noticias", "areas"] }
      },
      "allOf": [
        { "if": { "properties": { "tipo": { "const": "opcao" } } }, "then": { "required": ["opcoes"] } },
        { "if": { "properties": { "tipo": { "const": "lista" } } }, "then": { "required": ["itens"] } },
        { "if": { "properties": { "tipo": { "const": "dinamico" } } }, "then": { "required": ["fonte"] } }
      ]
    }
  }
}
